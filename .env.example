# Copy this file to .env and fill in your key. The key stays on the server and
# is never sent to the browser.
ANTHROPIC_API_KEY=

# --- Optional -----------------------------------------------------------------

# Claude model that performs the refinement.
# REFINER_MODEL=claude-fable-5-2

# Default thinking effort when the browser has not picked one: low | medium | high
# REFINER_EFFORT=medium

# Hard ceiling on output tokens per request (thinking + answer).
# REFINER_MAX_TOKENS=64000

# Server-side refusal fallback: if a safety classifier declines a request, the
# API re-runs it on Anthropic's recommended fallback model. Set to "off" to
# disable (required on platforms without server-side fallbacks, such as Amazon
# Bedrock, Vertex AI, and Microsoft Foundry).
# REFINER_FALLBACKS=default

# PORT=3000
# HOST=127.0.0.1
